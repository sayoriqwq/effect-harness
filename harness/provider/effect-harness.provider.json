              "targetPath": "harness/source.md",
              "purpose": "Provider-internal source entry boundary."
            },
            {
              "id": "effect-routes",
              "sourcePath": "harness/effect-routes.md",
              "targetPath": "harness/effect-routes.md",
              "purpose": "Effect source reading route table."
