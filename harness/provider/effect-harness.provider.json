{
  "schemaVersion": 1,
  "provider": {
    "id": "effect-harness",
    "contractVersion": "1",
    "providerVersion": "0.1.0",
    "defaultProfile": "codex-effect-v4"
  },
  "sourceEntries": {
    "effect-official-source": {
      "id": "effect-official-source",
      "kind": "provider-internal-github-subtree",
      "authority": "official",
      "name": "effect",
      "contract": {
        "path": "repos/effect.subtree.json",
        "owner": "partita",
        "format": "github-subtree"
      },
      "commands": {
        "status": "partita source status --contract repos/effect.subtree.json --name effect",
        "update": "partita source update --contract repos/effect.subtree.json --name effect --dry-run",
        "verify": "partita source verify --contract repos/effect.subtree.json --name effect"
      },
      "importBoundary": {
        "applicationImportsForbidden": true,
        "testImportsForbidden": true,
        "message": "Do not import from repos/effect in application or test code."
      }
    }
  },
  "providerRecord": {
    "requiredFields": [
      "schemaVersion",
      "id",
      "contractVersion",
      "providerVersion",
      "profile",
      "artifact",
      "artifact.sourceIdentity",
      "projectedContext",
      "options",
      "surfaces",
      "verificationRecordId"
    ],
    "manifestLookup": {
      "path": ".prelude/manifest.json",
      "providerList": "maintainProviders",
      "idField": "id",
      "recordPathField": "recordPath"
    },
    "sourceDelivery": {
      "mode": "artifact-identity-only",
      "description": "Prelude records provider artifact/source identity in the provider record. It does not materialize or maintain repos/effect in target repos."
    }
  },
  "profiles": {
    "codex-effect-v4": {
      "sourceEntry": "effect-official-source",
      "sourceBoundary": {
        "providerRepoInternal": true,
        "targetDelivery": "identity-only",
        "targetMustNotReceive": [
          "repos/effect",
          "repos/effect.subtree.json",
          "repos/effect/LLMS.md"
        ],
        "allowedTargetSourceIdentity": [
          "artifact.sourceIdentity.name",
          "artifact.sourceIdentity.contractPath",
          "artifact.sourceIdentity.github",
          "artifact.sourceIdentity.subtree"
        ]
      },
      "options": {
        "effect": "v4",
        "typecheck": "tsgo",
        "languageService": true,
        "floatingEffect": "error",
        "packageScopes": [
          "effect",
          "@effect/*",
          "@typescript/native-preview"
        ],
        "editorPolicy": {
          "sourceEntryPatterns": [
            "repos/**"
          ],
          "autoImportExclude": {
            "default": true,
            "vscode": {
              "typescript.preferences.autoImportFileExcludePatterns": [
                "repos/**"
              ],
              "javascript.preferences.autoImportFileExcludePatterns": [
                "repos/**"
              ]
            },
            "zed": {
              "settingsPath": ".zed/settings.json",
              "lsp": {
                "typescript-language-server": {
                  "initialization_options": {
                    "preferences": {
                      "autoImportFileExcludePatterns": [
                        "repos/**"
                      ]
                    }
                  }
                }
              }
            }
          },
          "watchExclude": {
            "default": "recommended",
            "requiresConfiguration": true,
            "vscode": {
              "files.watcherExclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ],
              "requiresExplicitOptIn": true
            }
          },
          "searchExclude": {
            "default": "recommended",
            "requiresConfiguration": true,
            "vscode": {
              "search.exclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ],
              "requiresExplicitOptIn": true
            }
          },
          "filesExclude": {
            "default": "preference",
            "requiresExplicitOptIn": true,
            "vscode": {
              "files.exclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ]
            }
          }
        }
      },
      "packageBaseline": {
        "effect": "4.0.0-beta.92",
        "@effect/platform-node": "4.0.0-beta.92",
        "@effect/vitest": "4.0.0-beta.92",
        "@effect/tsgo": "0.15.0",
        "@effect/language-service": "0.86.2",
        "@typescript/native-preview": "7.0.0-dev.20260630.1"
      },
      "managedSurfaces": {
        "targetReceives": [
          "provider record at .prelude/providers/effect-harness/provider.json",
          "package.json dependency and devDependency structured pointers",
          "tsconfig.json @effect/language-service plugin structured pointer"
        ],
        "targetDoesNotReceive": [
          "provider repo internal source pin repos/effect",
          "provider repo internal subtree contract repos/effect.subtree.json",
          "provider repo internal Effect LLMS route repos/effect/LLMS.md",
          "effect-harness runtime assets under .codex",
          "effect-harness AGENTS.md managed block",
          ".effect-harness.json standalone manifest",
          ".codex/effect-feedback feedback intake"
        ]
      },
      "contributions": {
        "packageJson": {
          "dependencies": {
            "effect": "4.0.0-beta.92",
            "@effect/platform-node": "4.0.0-beta.92"
          },
          "devDependencies": {
            "@effect/vitest": "4.0.0-beta.92",
            "@effect/tsgo": "0.15.0",
            "@effect/language-service": "0.86.2",
            "@typescript/native-preview": "7.0.0-dev.20260630.1"
          },
          "scripts": {
            "prepare": {
              "semantic": "prepare Effect TypeScript-Go backend",
              "defaultCommand": "effect-tsgo patch"
            },
            "typecheck": {
              "semantic": "primary Effect diagnostics",
              "defaultCommand": "tsgo --noEmit"
            }
          }
        },
        "tsconfig": {
          "compilerOptions": {
            "plugins": [
              {
                "name": "@effect/language-service",
                "diagnostics": true,
                "diagnosticSeverity": {
                  "floatingEffect": "error"
                },
                "ignoreEffectWarningsInTscExitCode": false,
                "ignoreEffectErrorsInTscExitCode": false
              }
            ]
          }
        }
      },
      "verification": {
        "status": [
          "provider internal source entry exists",
          "Partita GitHub subtree contract records source prefix, pin, anchor, route, and editor policy",
          "provider profile records source identity and package baseline"
        ],
        "verify": [
          "source pin exists as committed git subtree",
          "provider profile references the single Partita GitHub subtree contract",
          "tsgo --noEmit is the primary Effect diagnostic path",
          "@effect/language-service floatingEffect is error",
          "provider repository does not import from repos/effect or @effect/cli"
        ]
      }
    }
  }
}
