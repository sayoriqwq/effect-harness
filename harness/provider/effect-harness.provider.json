{
  "schemaVersion": 1,
  "provider": {
    "id": "effect-harness",
    "contractVersion": "1",
    "providerVersion": "0.1.0",
    "defaultProfile": "codex-effect-v4"
  },
  "sourceEntries": {
    "effect-official-source": {
      "id": "effect-official-source",
      "kind": "provider-internal-source-entry",
      "authority": "official",
      "name": "effect",
      "repository": "https://github.com/Effect-TS/effect-smol.git",
      "branch": "main",
      "prefix": "repos/effect",
      "anchor": {
        "manifest": "repos/effect.subtree.json",
        "field": "split",
        "value": "3475ee6c2bda6b05c6d7a12ce30c8bb840b5b1a6"
      },
      "llmDocument": "repos/effect/LLMS.md",
      "agentRoute": "harness/source.md",
      "materialization": {
        "mode": "git-subtree",
        "readOnlyForAgents": true
      },
      "commands": {
        "status": "pnpm effect:status",
        "update": "pnpm effect:update",
        "verify": "node bin/effect-harness.ts source-verify --harness ."
      },
      "importBoundary": {
        "applicationImportsForbidden": true,
        "testImportsForbidden": true,
        "message": "Do not import from repos/effect in application or test code."
      }
    }
  },
  "providerRecord": {
    "requiredFields": [
      "schemaVersion",
      "id",
      "contractVersion",
      "providerVersion",
      "profile",
      "artifact",
      "artifact.sourceIdentity",
      "projectedContext",
      "options.runtime",
      "runtime",
      "surfaces",
      "verificationRecordId"
    ],
    "manifestLookup": {
      "path": ".prelude/manifest.json",
      "providerList": "maintainProviders",
      "idField": "id",
      "recordPathField": "recordPath"
    },
    "sourceDelivery": {
      "mode": "artifact-identity-only",
      "description": "Prelude records the provider artifact/source identity in the provider record. It does not materialize or maintain repos/effect in target repos unless a future contract explicitly adds that surface."
    }
  },
  "profiles": {
    "codex-effect-v4": {
      "sourceEntry": "effect-official-source",
      "sourceBoundary": {
        "providerRepoInternal": true,
        "targetDelivery": "identity-only",
        "targetMustNotReceive": [
          "repos/effect",
          "repos/effect.subtree.json",
          "repos/effect/LLMS.md"
        ],
        "allowedTargetSourceIdentity": [
          "artifact.sourceIdentity.name",
          "artifact.sourceIdentity.repository",
          "artifact.sourceIdentity.branch",
          "artifact.sourceIdentity.anchor"
        ]
      },
      "options": {
        "runtime": "codex",
        "effect": "v4",
        "typecheck": "tsgo",
        "languageService": true,
        "floatingEffect": "error",
        "packageScopes": [
          "effect",
          "@effect/*",
          "@typescript/native-preview"
        ],
        "editorPolicy": {
          "sourceEntryPatterns": [
            "repos/**"
          ],
          "autoImportExclude": {
            "default": true,
            "vscode": {
              "typescript.preferences.autoImportFileExcludePatterns": [
                "repos/**"
              ],
              "javascript.preferences.autoImportFileExcludePatterns": [
                "repos/**"
              ]
            },
            "zed": {
              "settingsPath": ".zed/settings.json",
              "lsp": {
                "typescript-language-server": {
                  "initialization_options": {
                    "preferences": {
                      "autoImportFileExcludePatterns": [
                        "repos/**"
                      ]
                    }
                  }
                }
              }
            }
          },
          "watchExclude": {
            "default": "recommended",
            "requiresConfiguration": true,
            "vscode": {
              "files.watcherExclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ],
              "alsoAffects": [
                "project search",
                "project file tree"
              ],
              "requiresExplicitOptIn": true
            }
          },
          "searchExclude": {
            "default": "recommended",
            "requiresConfiguration": true,
            "vscode": {
              "search.exclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ],
              "alsoAffects": [
                "file scanning",
                "project file tree"
              ],
              "requiresExplicitOptIn": true
            }
          },
          "filesExclude": {
            "default": "preference",
            "requiresExplicitOptIn": true,
            "vscode": {
              "files.exclude": {
                "repos/**": true
              }
            },
            "zed": {
              "setting": "file_scan_exclusions",
              "patterns": [
                "repos/**"
              ],
              "alsoAffects": [
                "file scanning",
                "project search"
              ]
            }
          }
        }
      },
      "state": {
        "preludePath": ".prelude/providers/effect-harness/provider.json",
        "legacyStandalonePath": ".effect-harness.json"
      },
      "packageBaseline": {
        "effect": "4.0.0-beta.90",
        "@effect/platform-node": "4.0.0-beta.90",
        "@effect/vitest": "4.0.0-beta.90",
        "@effect/tsgo": "0.14.6",
        "@effect/language-service": "0.86.2",
        "@typescript/native-preview": "7.0.0-dev.20260624.1"
      },
      "managedSurfaces": {
        "targetReceives": [
          "provider record at .prelude/providers/effect-harness/provider.json",
          "AGENTS.md managed block delimited by effect-harness markers",
          "package.json dependency, devDependency, and script structured pointers",
          "tsconfig.json @effect/language-service plugin structured pointer",
          "provider-owned runtime assets declared by provider record surfaces",
          ".codex/effect-feedback directory and .gitkeep placeholder"
        ],
        "targetDoesNotReceiveByDefault": [
          "provider repo internal source pin repos/effect",
          "provider repo internal source manifest repos/effect.subtree.json",
          "provider repo internal Effect LLMS route repos/effect/LLMS.md",
          "effect-harness repo-local maintainer .codex/skills"
        ]
      },
      "contributions": {
        "packageJson": {
          "dependencies": {
            "effect": "4.0.0-beta.90",
            "@effect/platform-node": "4.0.0-beta.90"
          },
          "devDependencies": {
            "@effect/vitest": "4.0.0-beta.90",
            "@effect/tsgo": "0.14.6",
            "@effect/language-service": "0.86.2",
            "@typescript/native-preview": "7.0.0-dev.20260624.1"
          },
          "scripts": {
            "typecheck": {
              "semantic": "primary Effect diagnostics",
              "defaultCommand": "tsgo --noEmit"
            },
            "effect:status": {
              "semantic": "report effect-harness source, package, provider, and target drift"
            },
            "effect:verify": {
              "semantic": "verify effect-harness target conformance"
            },
            "verify": {
              "semantic": "must include pnpm effect:verify without replacing target-owned checks"
            }
          }
        },
        "tsconfig": {
          "compilerOptions": {
            "plugins": [
              {
                "name": "@effect/language-service",
                "options": {
                  "diagnosticSeverity": {
                    "floatingEffect": "error"
                  }
                }
              }
            ]
          }
        },
        "agentsBlock": {
          "file": "AGENTS.md",
          "startMarker": "<!-- effect-harness:start -->",
          "endMarker": "<!-- effect-harness:end -->",
          "surfaceKind": "managedBlock"
        },
        "runtimeAssets": {
          "surfaceKind": "ownedFile",
          "authority": "provider-record-surfaces",
          "namespace": ".codex",
          "assets": [
            ".codex/skills/effect-code/SKILL.md",
            ".codex/skills/effect-code/agents/openai.yaml",
            ".codex/skills/effect-feedback/SKILL.md",
            ".codex/skills/effect-feedback/agents/openai.yaml",
            ".codex/agents/effect-worker.md"
          ],
          "feedbackDirectory": ".codex/effect-feedback",
          "feedbackPlaceholder": ".codex/effect-feedback/.gitkeep",
          "sourceState": "runtime assets are provider-owned target surfaces. External source-entry/pin management belongs to Partita and provider-internal source entries, not this target provider contract."
        }
      },
      "verification": {
        "status": [
          "provider internal source entry exists and reports drift",
          "target package declarations match the package baseline or catalog entries",
          "provider state records this provider id, version, profile, resolved options, artifact identity, and source identity"
        ],
        "verify": [
          "package.json contributions are present by key",
          "tsgo --noEmit is the primary Effect diagnostic path",
          "@effect/language-service floatingEffect is error",
          "AGENTS.md contains the current effect-harness managed block",
          "provider runtime assets match ownedFile surfaces when those surfaces are declared",
          "guardrails pass"
        ]
      }
    }
  }
}
