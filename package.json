{
  "name": "@sayoriqwq/effect-harness",
  "type": "module",
  "version": "0.3.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.2",
  "description": "Effect v4 beta Prelude Harness Module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayoriqwq/effect-harness"
  },
  "exports": {
    "./prelude": {
      "types": "./dist/prelude.d.ts",
      "import": "./dist/prelude.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "artifact-assets",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "pnpm source-pins:publish && tsdown --config tsdown.config.ts",
    "acceptance:cross-repo": "node --experimental-strip-types tests/acceptance/cross-repo.ts",
    "prepack": "pnpm build",
    "dev": "pnpm build",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "effect-tsgo patch",
    "source-pin:publish:effect": "partita pin publish --name effect --prefix repos/effect --contract repos/effect.subtree.json --archive artifact-assets/effect/reference-archives/effect.pta --provenance artifact-assets/effect/reference-archives/effect.json",
    "source-pin:publish:tsgo": "partita pin publish --name tsgo --prefix repos/tsgo --contract repos/tsgo.subtree.json --archive artifact-assets/effect/reference-archives/tsgo.pta --provenance artifact-assets/effect/reference-archives/tsgo.json",
    "source-pins:check-clean": "git diff --exit-code HEAD -- artifact-assets/effect/reference-archives/effect.pta artifact-assets/effect/reference-archives/effect.json artifact-assets/effect/reference-archives/tsgo.pta artifact-assets/effect/reference-archives/tsgo.json",
    "source-pins:publish": "pnpm source-pin:publish:effect && pnpm source-pin:publish:tsgo",
    "test": "vitest run",
    "test:focused": "vitest run",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:tests && pnpm typecheck:tooling",
    "typecheck:source": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:tests": "tsc6 --noEmit -p tsconfig.tests.json",
    "typecheck:tooling": "tsc6 --noEmit -p tsconfig.tooling.json",
    "verify": "pnpm build && pnpm source-pins:check-clean && pnpm typecheck && pnpm test && pnpm lint --max-warnings 0 && pnpm knip"
  },
  "knip": {
    "ignoreDependencies": [
      "@effect/language-service",
      "@effect/platform-node"
    ]
  },
  "dependencies": {
    "@sayoriqwq/prelude-contract": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@sayoriqwq/partita": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
