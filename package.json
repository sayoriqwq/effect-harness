{
  "name": "effect-harness-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Shared Effect v4 beta harness for local target projects.",
  "license": "MIT",
  "bin": {
    "effect-harness": "bin/effect-harness.ts"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "pnpm typecheck",
    "dev": "node bin/effect-harness.ts --help",
    "effect:patch": "effect-tsgo patch",
    "effect:setup": "effect-tsgo setup",
    "effect:status": "node bin/effect-harness.ts status --harness .",
    "effect:update": "node bin/effect-harness.ts update-pin --harness .",
    "effect:verify": "node bin/effect-harness.ts self-verify --harness .",
    "guardrails": "node bin/effect-harness.ts self-verify --harness .",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "effect-tsgo patch",
    "test": "vitest run tests/*.test.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "verify": "pnpm effect:verify && pnpm typecheck && pnpm test && pnpm lint && pnpm knip"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
