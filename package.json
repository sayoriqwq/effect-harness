{
  "name": "effect-harness-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.2",
  "description": "Shared Effect v4 beta harness for local target projects.",
  "license": "MIT",
  "main": "dist/bin/effect-harness.js",
  "bin": {
    "effect-harness": "dist/bin/effect-harness.js"
  },
  "files": [
    "HARNESS.md",
    "README.md",
    "dist",
    "guide",
    "harness",
    "repos",
    "repos/effect.subtree.json"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "craft-skills:check": "node bin/effect-harness.ts craft-skills check --harness .",
    "craft-skills:sync": "node bin/effect-harness.ts craft-skills sync --harness .",
    "prepack": "pnpm build",
    "dev": "pnpm build && node dist/bin/effect-harness.js --help",
    "effect:patch": "effect-tsgo patch",
    "effect:setup": "effect-tsgo setup",
    "effect:status": "node bin/effect-harness.ts status --harness .",
    "effect:update": "node bin/effect-harness.ts update-pin --harness .",
    "effect:verify": "node bin/effect-harness.ts self-verify --harness .",
    "guardrails": "node bin/effect-harness.ts self-verify --harness .",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "publish:npm": "pnpm build && node dist/bin/effect-harness.js publish --harness .",
    "prepare": "effect-tsgo patch",
    "test": "vitest run tests/*.test.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "verify": "pnpm effect:verify && pnpm typecheck && pnpm test && pnpm lint && pnpm knip"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
