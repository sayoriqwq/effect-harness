{
  "name": "@sayoriqwq/effect-harness",
  "type": "module",
  "version": "0.2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.2",
  "description": "Effect v4 beta Prelude Harness Module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayoriqwq/effect-harness"
  },
  "exports": {
    "./prelude": {
      "types": "./dist/prelude.d.ts",
      "import": "./dist/prelude.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "diagnostics",
    "dist",
    "prelude-assets",
    "repos/effect",
    "repos/effect.subtree.json",
    "repos/tsgo",
    "repos/tsgo.subtree.json"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm build",
    "dev": "pnpm build",
    "knip": "knip",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "effect-tsgo patch",
    "test": "vitest run tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm lint --max-warnings 0 && pnpm knip"
  },
  "knip": {
    "ignoreDependencies": [
      "@effect/language-service"
    ]
  },
  "dependencies": {
    "@sayoriqwq/prelude-contract": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
